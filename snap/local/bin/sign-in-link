#!/bin/bash
set -eu
. "$SNAP/bin/lib.sh"
[ $# -eq 1 ] || die "usage: sudo fluxer-server.sign-in-link <user-id>"
export SOCK="$SNAP_COMMON/operator.sock"
exec "$SNAP/opt/node/bin/node" -e '
const http = require("http");
const req = http.request({socketPath: process.env.SOCK, path: "/admin/users/" + process.argv[1] + "/sign-in-link", method: "POST",
  headers: {"X-Fluxer-Operator-Host-User": "snap-root", "Content-Length": 0}}, (res) => {
  let b = ""; res.on("data", (d) => b += d);
  res.on("end", () => { console.log(b); process.exit(res.statusCode === 200 ? 0 : 1); });
});
req.on("error", (e) => { console.error(e.message); process.exit(1); });
req.end();
' "$1"
